# -----------------------------------------------------------------------------
# Laravel Application Environment (v1 Skeleton)
# Self-use local swing assistant; paper-first safety defaults.
# -----------------------------------------------------------------------------

APP_NAME="LeanSwingAssistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lean_swing_assistant
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# OpenAI (used by Laravel for prompt-based ranking/interpretation)
# No hardcoded secrets. Fill locally in .env.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Trading Safety Controls (canonical)
# -----------------------------------------------------------------------------
# Allowed values: paper | live
TRADING_MODE=paper

# Must be true to permit live mode. If TRADING_MODE=live and this is not true,
# application must fail fast.
LIVE_TRADING_ENABLED=false

# ----------------------------------------------------------------------------
# T11 Paper Trade Execution
# ----------------------------------------------------------------------------
BROKER_TRADING_MODE=paper
EXECUTION_ENABLED=false
EXECUTION_DRIVER=simulated
EXECUTION_DRY_RUN=true
EXECUTION_DEFAULT_QUANTITY=1
PAPER_ORDER_QUANTITY=1
BREAKOUT_STOP_LIMIT_BUFFER=0.10
EXECUTION_PYTHON_EXECUTABLE=python

# ----------------------------------------------------------------------------
# T14.1 Workflow Wrappers
# ----------------------------------------------------------------------------
# Emergency fallback only when DB active universe is empty.
WORKFLOW_SYMBOLS=AAPL,MSFT,NVDA
PYTHON_IBKR_BASE_PATH=../python_ibkr
# Optional/manual only (used by universe:build-ibkr when run manually, not by scheduler).
IBKR_SCANNER_CODES=MOST_ACTIVE,TOP_PERC_GAIN,HOT_BY_VOLUME,TOP_TRADE_COUNT
UNIVERSE_MAX_SYMBOLS=5000
UNIVERSE_RECENT_DAYS=14
DAILY_FETCH_BATCH_SIZE=100
DAILY_FETCH_BATCH_TIMEOUT_SECONDS=180
DAILY_FETCH_MAX_TOTAL_SECONDS=1800
DAILY_FETCH_MIN_VALID_SYMBOLS=1
DAILY_FETCH_STOP_ON_BATCH_FAILURE=false

NASDAQ_UNIVERSE_INCLUDE_ETFS=false
NASDAQ_UNIVERSE_INCLUDE_UNITS=false
NASDAQ_UNIVERSE_INCLUDE_WARRANTS=false
NASDAQ_UNIVERSE_MAX_SYMBOLS=1000
